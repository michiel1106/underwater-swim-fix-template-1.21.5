{
	"schemaVersion": 1,
	"id": "underwater-swim-fix",
	"version": "${version}",
	"name": "Underwater Swim Fix",
	"description": "Fixes the bug where if you hit an entity while swimming, the server and client desyncs",
	"authors": [
		"Bikerboys"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/underwater-swim-fix/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"bikerboys.underwaterswimfix.UnderwaterSwimFix"
		],
		"client": [
			"bikerboys.underwaterswimfix.UnderwaterSwimFixClient"
		]
	},
	"mixins": [
		"underwater-swim-fix.mixins.json",
		{
			"config": "underwater-swim-fix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": ">=26.3",
		"java": ">=25"
	}
}